<?xml version="1.0" encoding="UTF-8"?>
<PluginConfig>

    <SupportURL>https://github.com/Highsteads/EvoHomeControl</SupportURL>

    <Field id="sep_owm" type="separator"/>
    <Field id="lbl_owm" type="label">
        <Label>OPENWEATHERMAP</Label>
    </Field>
    <Field id="lbl_secrets_owm" type="label">
        <Label>Values are read from IndigoSecrets.py first (OWM_API_KEY, LATITUDE, LONGITUDE). The fields below are a fallback for users without IndigoSecrets.py.</Label>
    </Field>
    <Field id="owmApiKey" type="textfield" defaultValue="">
        <Label>OWM API key (fallback if not in IndigoSecrets):</Label>
    </Field>
    <Field id="owmLatitude" type="textfield" defaultValue="">
        <Label>Latitude (fallback):</Label>
    </Field>
    <Field id="owmLongitude" type="textfield" defaultValue="">
        <Label>Longitude (fallback):</Label>
    </Field>

    <Field id="sep_weather" type="separator"/>
    <Field id="lbl_weather" type="label">
        <Label>WEATHER SOURCE</Label>
    </Field>
    <Field id="weatherBypass" type="checkbox" defaultValue="false">
        <Label>Force OWM temperature (bypass Ecowitt — enable when Ecowitt is unavailable):</Label>
    </Field>
    <Field id="ecowittDeviceId" type="textfield" defaultValue=""
           visibleBindingId="weatherBypass" visibleBindingValue="false">
        <Label>Ecowitt outdoor sensor device ID:</Label>
    </Field>
    <Field id="ecowittIndoorDeviceId" type="textfield" defaultValue="">
        <Label>Ecowitt indoor sensor device ID (pressure / indoor temp / humidity):</Label>
    </Field>
    <Field id="weatherBypassTemp" type="textfield" defaultValue="6.0">
        <Label>Fallback temperature when both Ecowitt and OWM unavailable (degC):</Label>
    </Field>

    <Field id="sep_notify" type="separator"/>
    <Field id="lbl_notify" type="label">
        <Label>OVERHEAT ALERTS</Label>
    </Field>
    <Field id="pushoverUserKey" type="textfield" defaultValue="">
        <Label>Pushover user key (leave blank to use IndigoSecrets.py):</Label>
    </Field>
    <Field id="alertEmailAddress" type="textfield" defaultValue="">
        <Label>Overheat alert email (fallback if OVERHEAT_ALERT_EMAIL not in IndigoSecrets):</Label>
    </Field>

    <Field id="sep_timing" type="separator"/>
    <Field id="lbl_timing" type="label">
        <Label>HEATING CYCLE</Label>
    </Field>
    <Field id="runIntervalMins" type="menu" defaultValue="5">
        <Label>Heating cycle interval:</Label>
        <List>
            <Option value="5">5 minutes (recommended)</Option>
            <Option value="10">10 minutes</Option>
            <Option value="15">15 minutes</Option>
        </List>
    </Field>

    <Field id="sep_snow" type="separator"/>
    <Field id="lbl_snow" type="label">
        <Label>SNOW FORECAST</Label>
    </Field>
    <Field id="snowHeatingEnabled" type="checkbox" defaultValue="true">
        <Label>Apply heating boost when snow is forecast:</Label>
    </Field>
    <Field id="snowForecastHours" type="menu" defaultValue="12"
           visibleBindingId="snowHeatingEnabled" visibleBindingValue="true">
        <Label>Look-ahead window for snow detection:</Label>
        <List>
            <Option value="6">6 hours</Option>
            <Option value="12">12 hours (recommended)</Option>
            <Option value="24">24 hours</Option>
        </List>
    </Field>
    <Field id="snowHeatingBoost" type="menu" defaultValue="1.0"
           visibleBindingId="snowHeatingEnabled" visibleBindingValue="true">
        <Label>Heating boost when snow forecast (degC):</Label>
        <List>
            <Option value="0.5">+0.5 degC</Option>
            <Option value="1.0">+1.0 degC (recommended)</Option>
            <Option value="1.5">+1.5 degC</Option>
            <Option value="2.0">+2.0 degC</Option>
        </List>
    </Field>

    <Field id="sep_summer" type="separator"/>
    <Field id="lbl_summer" type="label">
        <Label>SUMMER SHUT-OFF</Label>
    </Field>
    <Field id="lbl_summer_help" type="label">
        <Label>When enabled, the whole house turns OFF for summer: every radiator is held at the 8 degC frost setpoint and the En Suite floor heating is switched off. Heating is restored automatically on the ON date. Use the "Force Heating On (24 hours)" action or menu item to override for a single day.</Label>
    </Field>
    <Field id="summerLockoutEnabled" type="checkbox" defaultValue="true">
        <Label>Enable summer shut-off:</Label>
    </Field>
    <Field id="summerOffStartMonth" type="menu" defaultValue="6"
           visibleBindingId="summerLockoutEnabled" visibleBindingValue="true">
        <Label>Shut-off starts — month:</Label>
        <List>
            <Option value="1">January</Option>
            <Option value="2">February</Option>
            <Option value="3">March</Option>
            <Option value="4">April</Option>
            <Option value="5">May</Option>
            <Option value="6">June</Option>
            <Option value="7">July</Option>
            <Option value="8">August</Option>
            <Option value="9">September</Option>
            <Option value="10">October</Option>
            <Option value="11">November</Option>
            <Option value="12">December</Option>
        </List>
    </Field>
    <Field id="summerOffStartDay" type="menu" defaultValue="1"
           visibleBindingId="summerLockoutEnabled" visibleBindingValue="true">
        <Label>Shut-off starts — day:</Label>
        <List>
            <Option value="1">1</Option><Option value="2">2</Option><Option value="3">3</Option>
            <Option value="4">4</Option><Option value="5">5</Option><Option value="6">6</Option>
            <Option value="7">7</Option><Option value="8">8</Option><Option value="9">9</Option>
            <Option value="10">10</Option><Option value="11">11</Option><Option value="12">12</Option>
            <Option value="13">13</Option><Option value="14">14</Option><Option value="15">15</Option>
            <Option value="16">16</Option><Option value="17">17</Option><Option value="18">18</Option>
            <Option value="19">19</Option><Option value="20">20</Option><Option value="21">21</Option>
            <Option value="22">22</Option><Option value="23">23</Option><Option value="24">24</Option>
            <Option value="25">25</Option><Option value="26">26</Option><Option value="27">27</Option>
            <Option value="28">28</Option><Option value="29">29</Option><Option value="30">30</Option>
            <Option value="31">31</Option>
        </List>
    </Field>
    <Field id="summerOnMonth" type="menu" defaultValue="9"
           visibleBindingId="summerLockoutEnabled" visibleBindingValue="true">
        <Label>Heating returns — month:</Label>
        <List>
            <Option value="1">January</Option>
            <Option value="2">February</Option>
            <Option value="3">March</Option>
            <Option value="4">April</Option>
            <Option value="5">May</Option>
            <Option value="6">June</Option>
            <Option value="7">July</Option>
            <Option value="8">August</Option>
            <Option value="9">September</Option>
            <Option value="10">October</Option>
            <Option value="11">November</Option>
            <Option value="12">December</Option>
        </List>
    </Field>
    <Field id="summerOnDay" type="menu" defaultValue="30"
           visibleBindingId="summerLockoutEnabled" visibleBindingValue="true">
        <Label>Heating returns — day:</Label>
        <List>
            <Option value="1">1</Option><Option value="2">2</Option><Option value="3">3</Option>
            <Option value="4">4</Option><Option value="5">5</Option><Option value="6">6</Option>
            <Option value="7">7</Option><Option value="8">8</Option><Option value="9">9</Option>
            <Option value="10">10</Option><Option value="11">11</Option><Option value="12">12</Option>
            <Option value="13">13</Option><Option value="14">14</Option><Option value="15">15</Option>
            <Option value="16">16</Option><Option value="17">17</Option><Option value="18">18</Option>
            <Option value="19">19</Option><Option value="20">20</Option><Option value="21">21</Option>
            <Option value="22">22</Option><Option value="23">23</Option><Option value="24">24</Option>
            <Option value="25">25</Option><Option value="26">26</Option><Option value="27">27</Option>
            <Option value="28">28</Option><Option value="29">29</Option><Option value="30">30</Option>
            <Option value="31">31</Option>
        </List>
    </Field>
    <Field id="lbl_summer_note" type="label"
           visibleBindingId="summerLockoutEnabled" visibleBindingValue="true">
        <Label>The "returns" date is the day heating comes back on — e.g. 30 September means off 1 June to 29 September inclusive, normal heating from 30 September.</Label>
    </Field>

    <Field id="sep_logging" type="separator"/>
    <Field id="lbl_logging" type="label">
        <Label>LOGGING</Label>
    </Field>
    <Field id="logHourlyDumpToEventLog" type="checkbox" defaultValue="false">
        <Label>Show the hourly weather and room table in the Indigo Event Log:</Label>
        <Description>Off by default. Every hour this plugin builds a full weather header plus a line for each of the 12 rooms - about 40 lines, so roughly 960 a day in the Event Log the whole server shares. Those lines are always written to this plugin's own daily log (radiator_YYYY-MM-DD.log, in its Preferences folder), so leaving this off loses nothing. Warnings and errors always reach the Event Log whatever this is set to. To see one full dump without turning this on, use Plugins - EvoHome Heating Controller - Show Full Weather Log.</Description>
    </Field>

    <Field id="sep_debug" type="separator"/>
    <Field id="showDebugInfo" type="checkbox" defaultValue="false">
        <Label>Enable debug logging:</Label>
    </Field>

</PluginConfig>
